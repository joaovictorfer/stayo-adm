# Stayo Core API (domínio Grupo B — properties, reservations, guests, etc.)
# Sem estas duas, o Admin usa o client mock (createMockCoreApiClient()).
VITE_CORE_API_URL=
VITE_CORE_APP_TOKEN=

# Supabase (domínio Grupo A — proprietário, implantação, propostas, portal,
# cobrança, auditoria — ver docs/OWNER_IMPLEMENTATION_ARCHITECTURE.md).
# Sem estas duas, o Admin usa o adapter local (localStorage,
# createLocalAdminApiClient()) — funciona para demonstração/desenvolvimento,
# mas não é persistência real nem multiusuário.
#
# Use SEMPRE a chave publicável/anon aqui — nunca a "service_role"/"secret". A
# service_role nunca deve existir em código de frontend/bundle (ver
# docs/SECURITY_AND_RLS.md). O Lovable Cloud gera VITE_SUPABASE_PUBLISHABLE_KEY
# automaticamente; VITE_SUPABASE_ANON_KEY (nome antigo) também é aceito.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Conversão de Implantação em Property/Owner oficiais do Core (Fase 11).
# Desligada por padrão — mesmo ligada, a conversão não fabrica IDs: o Core
# ainda não expõe um endpoint de escrita real (ver src/lib/core-conversion.ts).
VITE_ENABLE_CORE_CONVERSION=
